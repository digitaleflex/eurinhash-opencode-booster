{
  "$schema": "https://raw.githubusercontent.com/juhas96/opencode-plugin-preload-skills/main/schema.json",
  "_comment": "Smart skill loading: skills chargées sur déclencheurs (type de fichier, agent, mot-clé), sous budget tokens. Voir https://github.com/juhas96/opencode-plugin-preload-skills",
  "agentSkills": {
    "plan": ["verification-planning"],
    "build": ["tollfree-token-efficiency", "tollfree-enterprise-development"],
    "reviewer": [
      "tollfree-verification",
      "code-review",
      "requesting-code-review",
      "verification-before-completion"
    ],
    "planner": ["verification-planning", "executing-plans"],
    "builder": [
      "tollfree-token-efficiency",
      "tollfree-enterprise-development",
      "test-driven-development",
      "systematic-debugging"
    ],
    "tester": ["test-driven-development", "systematic-debugging", "diagnosing-bugs"],
    "architect": ["executing-plans"],
    "quality-engineer": ["verification-before-completion", "diagnosing-bugs"],
    "security": ["git-guardrails-claude-code"],
    "git-engineer": ["resolving-merge-conflicts", "git-guardrails-claude-code", "setup-pre-commit"]
  },
  "fileTypeSkills": {
    ".py": ["tollfree-enterprise-development"],
    ".ts,.tsx,.js": ["tollfree-code-navigation", "tollfree-token-efficiency"]
  },
  "contentTriggers": {
    "worktree": ["worktrees"],
    "simplify OR refactor for clarity": ["simplify"],
    "codemap OR unfamiliar repository": ["codemap"],
    "deep work OR large refactor": ["deepwork"],
    "code review OR review the diff OR review this PR": ["code-review", "requesting-code-review"],
    "debug OR diagnose OR failing OR broken OR slow": ["systematic-debugging", "diagnosing-bugs"],
    "merge conflict OR rebase conflict": ["resolving-merge-conflicts"],
    "pre-commit OR husky OR lint-staged": ["setup-pre-commit"],
    "TDD OR test-driven OR test first": ["test-driven-development"],
    "verify before commit OR claim complete": ["verification-before-completion"],
    "finish branch OR merge strategy": ["finishing-a-development-branch"]
  },
  "maxTokens": 10000,
  "useSummaries": true,
  "useMinification": "standard",
  "persistAfterCompaction": true,
  "showToasts": false,
  "enableTools": true,
  "analytics": true
}
